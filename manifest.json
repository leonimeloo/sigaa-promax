{
  "manifest_version": 3,
  "name": "SIGAA UFABC Pro Max",
  "version": "2.1.0",
  "description": "Redesenha o SIGAA da UFABC: painel do aluno, horário semanal legível, turma virtual, notas e fórum modernos.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://sig.ufabc.edu.br/sigaa/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "SIGAA UFABC Pro Max — opções",
    "default_popup": "options/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}